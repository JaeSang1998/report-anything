{
  "name": "report-anything-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "tsc -b packages/cli && cp packages/react/src/styles.css packages/react/dist/styles.css",
    "typecheck": "tsc -b packages/cli && tsc -p examples/playground --noEmit",
    "test": "vitest run",
    "dev": "pnpm --filter playground dev",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
