    "monthly": {
      "from": "subs",
      "transform": [
        {
          "op": "aggregate",
          "groupBy": [
            "month"
          ],
          "measures": [
            {
              "field": "mrr",
              "agg": "sum",
              "as": "mrr"
            },
            {
              "field": "customers",
              "agg": "sum",
              "as": "customers"
            },
            {
              "field": "new_mrr",
              "agg": "sum",
              "as": "new_mrr"
            },
            {
              "field": "expansion_mrr",
              "agg": "sum",
              "as": "expansion_mrr"
            },
            {
              "field": "churned_mrr",
              "agg": "sum",
              "as": "churned_mrr"
            }
          ]
        },
        {
          "op": "derive",
          "as": "net_new_mrr",
          "expr": "new_mrr + expansion_mrr - churned_mrr"
        },
        {
          "op": "derive",
          "as": "churned_negative",
          "expr": "-churned_mrr"
        },
        {
          "op": "window",
          "fn": "pctChange",
          "field": "mrr",
          "as": "growth",
          "sortBy": "month"
        }
      ],
      "fields": [
        {
          "name": "month",
          "label": "Month",
          "format": "date:month"
        },
        {
          "name": "mrr",
          "label": "MRR",
          "format": "currency:0"
        },
        {
          "name": "new_mrr",
          "label": "New",
          "format": "currency:0"
        },
        {
          "name": "expansion_mrr",
          "label": "Expansion",
          "format": "currency:0"
        },
        {
          "name": "churned_negative",
          "label": "Churned",
          "format": "currency:0"
        },
        {
          "name": "net_new_mrr",
          "label": "Net new MRR",
          "format": "currency:0"
        },
        {
          "name": "growth",
          "label": "MoM growth",
          "format": "percent"
        }
      ]
    },
    "last12": {
      "from": "monthly",
      "transform": [
        {
          "op": "filter",
          "expr": "month >= '2025-10-01'"
        }
      ]
    },
    "latest": {
      "from": "subs",
      "transform": [
        {
          "op": "filter",
          "expr": "month == '2026-09-01'"
        },
        {
          "op": "derive",
          "as": "arpa",
          "expr": "mrr / customers"
        },
        {
          "op": "window",
          "fn": "share",
          "field": "mrr",
          "as": "share"
        },
        {
          "op": "sort",
          "by": "-mrr"
        }
      ],
      "fields": [
        {
          "name": "plan",
          "label": "Plan"
        },
        {
          "name": "mrr",
          "label": "MRR",
          "format": "currency:0"
        },
        {
          "name": "customers",
          "label": "Customers",
          "format": "integer"
        },
        {
          "name": "arpa",
          "label": "ARPA",
          "format": "currency:0"
        },
        {
          "name": "logo_churn_rate",
          "label": "Logo churn",
          "format": "percent"
        },
        {
          "name": "share",
          "label": "Share of MRR",
          "format": "percent"
        }
      ]
    },
    "starter_churn": {
      "from": "subs",
      "transform": [
        {
          "op": "filter",
          "expr": "plan == 'Starter'"
        }
      ],
      "fields": [
        {
          "name": "month",
          "label": "Month",
          "format": "date:month"
        },
        {
          "name": "logo_churn_rate",
          "label": "Starter logo churn",
          "format": "percent"
        }
      ]
    },
    "sep_movement": {
      "from": "monthly",
      "transform": [
        {
          "op": "filter",
          "expr": "month == '2026-09-01'"
        },
        {
          "op": "rename",
          "fields": {
            "new_mrr": "New",
            "expansion_mrr": "Expansion",
            "churned_negative": "Churned"
          }
        },
        {
          "op": "select",
          "fields": [
            "New",
            "Expansion",
            "Churned"
          ]
        },
        {
          "op": "fold",
          "fields": [
            "New",
            "Expansion",
            "Churned"
          ],
          "as": [
            "step",
            "mrr"
          ]
        }
      ],
      "fields": [
        {
          "name": "step",
          "label": "Movement"
        },
        {
          "name": "mrr",
          "label": "MRR",
          "format": "currency:0"
        }
      ]
    }
  },
  "sections": [
    {
      "id": "headline",
      "title": "Headline",
      "blocks": [
        {
          "id": "kpis",
          "type": "kpi",
          "items": [
            {
              "label": "MRR",
              "value": {
                "data": "monthly",
                "field": "mrr",
                "where": "month == '2026-09-01'"
              },
              "compareTo": {
                "data": "monthly",
                "field": "mrr",
                "where": "month == '2025-09-01'"
              },
              "format": "currency:0",
              "deltaLabel": "vs Sep 2025"
            },
            {
              "label": "Net new MRR",
              "value": {
                "data": "monthly",
                "field": "net_new_mrr",
                "where": "month == '2026-09-01'"
              },
              "compareTo": {
                "data": "monthly",
                "field": "net_new_mrr",
                "where": "month == '2026-08-01'"
              },
              "format": "currency:0",
              "deltaLabel": "vs Aug"
            },
            {
              "label": "Customers",
              "value": {
                "data": "monthly",
                "field": "customers",
                "where": "month == '2026-09-01'"
              },
              "compareTo": {
                "data": "monthly",
                "field": "customers",
                "where": "month == '2025-09-01'"
              },
              "format": "integer",
              "deltaLabel": "vs Sep 2025"
            },
            {
              "label": "Starter logo churn",
              "value": {
                "data": "starter_churn",
                "field": "logo_churn_rate",
                "agg": "avg",
                "where": "month >= '2026-07-01'"
              },
              "compareTo": {
                "data": "starter_churn",
                "field": "logo_churn_rate",
                "agg": "avg",
                "where": "month >= '2026-04-01' and month < '2026-07-01'"
              },
              "format": "percent",
              "goodWhen": "down",
              "deltaLabel": "Q3 vs Q2"
            }
          ]
        }
      ]
    },
    {
