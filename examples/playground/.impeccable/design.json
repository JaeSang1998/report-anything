      "html": "<div class=\"ds-menu\"><button class=\"ds-menu-item\"><span><span>Upload a file</span><small>CSV, JSON, XLSX</small></span></button><button class=\"ds-menu-item\"><span><span>Sample dataset</span><small>Sales, 1,200 rows</small></span></button></div>",
      "css": ".ds-menu{width:280px;padding:6px;border-radius:16px;background:var(--bg-elevated,#fff);box-shadow:var(--shadow-menu,0 2px 6px rgb(9 9 11 / .06),0 16px 40px rgb(9 9 11 / .14));font-family:var(--font,'Geist Variable',system-ui,sans-serif);animation:ds-menu-in 180ms cubic-bezier(.16,1,.3,1)}@keyframes ds-menu-in{from{opacity:0;transform:translateY(4px) scale(.98)}}.ds-menu-item{display:flex;width:100%;padding:8px 10px;border:none;border-radius:10px;background:none;color:var(--fg,#09090b);font:inherit;font-size:14px;line-height:20px;text-align:left;cursor:pointer}.ds-menu-item:hover,.ds-menu-item:focus-visible{background:var(--surface-2,#f4f4f5);outline:none}.ds-menu-item small{display:block;font-size:12px;line-height:16px;color:var(--fg-3,#71717a)}"
    },
