  "narrative": {
    "northStar": "The Familiar Room",
    "overview": "The playground is an AI chat app played straight, at the craft level of the category's best shells, so a visitor learns nothing about the frame and spends all their attention on the report. Zinc neutrals on a white or near-black ground, one blue reserved for focus and caret, Geist for everything the UI says and Geist Mono for everything the machine says.\n\nSeparation comes from fills and space, never from lines. The sidebar is one tonal step off the ground, the composer and user bubble one step further, hover one step beyond that. Shadows exist only where something floats above the page (composer, menu, sheet, drawer). The report itself renders bare in the thread in Web mode; it is re-themed through the `--ra-*` and `--ra-theme-c1..8` variables, so it reads as part of the same room in dark mode.",
    "keyCharacteristics": [
      "Three-step tonal ladder (surface-1, -2, -3) does all structural work.",
      "One accent, used for focus rings, caret and selection only.",
      "Rounded, soft geometry (6–28px), circles for avatar and send.",
      "Ghost controls: icon buttons, suggestions, menu items and history rows have no fill until hover.",
      "Motion is quiet and eased; the one expressive moment is report blocks rising as they land."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "The accent marks focus and the caret only; active state is shown with fill and ink, never blue.",
        "section": "colors"
      },
      {
        "name": "The Tonal Ladder Rule",
        "body": "Structure is expressed by stepping ground → surface-1 → surface-2 → surface-3. If a line seems needed, step a fill instead.",
        "section": "colors"
      },
      {
        "name": "The No-Ligature Rule",
        "body": "Message bubbles and the composer disable contextual alternates (`calt` 0) so code like `-->` stays literal.",
        "section": "typography"
      },
      {
        "name": "The Float-Only Shadow Rule",
        "body": "Only things that sit above the page get a shadow; nothing inline in the thread does.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** separate regions with the surface-1/2/3 ladder and space.",
      "**Do** keep controls ghost until hover, then fill one step.",
      "**Do** use lucide icons at their default stroke, 14–18px.",
      "**Do** let report blocks rise once while the report is building (520ms, 10px up, 3px blur clearing, ease-out) and nowhere else.",
      "**Do** honour reduced motion: all animations and transitions collapse to 1ms."
    ],
    "donts": [
      "**Don't** put borders, cards or outlined boxes in the chat; errors and files included.",
      "**Don't** use pills or gradients.",
      "**Don't** use the accent for active, selected or brand color.",
      "**Don't** add shadows to inline thread elements."
    ]
  }
}