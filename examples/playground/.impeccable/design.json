      "css": ".ds-seg{display:inline-flex;padding:2px;border-radius:10px;background:var(--surface-2,#f4f4f5);font-family:var(--font,'Geist Variable',system-ui,sans-serif)}.ds-seg button{height:26px;padding:0 10px;border:none;border-radius:8px;background:none;font:inherit;font-size:12px;color:var(--fg-2,#52525b);cursor:pointer}.ds-seg button:hover{color:var(--fg,#09090b)}.ds-seg button:focus-visible{outline:2px solid var(--accent,#2563eb);outline-offset:2px}.ds-seg button[aria-pressed=true]{background:var(--bg-elevated,#fff);color:var(--fg,#09090b);box-shadow:0 1px 2px rgb(9 9 11 / .08)}"
    },
