      "css": ".ds-step{font-family:var(--font,'Geist Variable',system-ui,sans-serif);font-size:13px;line-height:20px;color:var(--fg-2,#52525b)}.ds-step-head{display:inline-flex;align-items:center;gap:8px;padding:3px 8px 3px 6px;border-radius:8px;list-style:none;cursor:pointer}.ds-step-head::-webkit-details-marker{display:none}.ds-step-head:hover{background:var(--surface-2,#f4f4f5);color:var(--fg,#09090b)}.ds-step-head:focus-visible{outline:2px solid var(--accent,#2563eb);outline-offset:2px}.ds-chev{color:var(--fg-3,#71717a);transition:transform 200ms cubic-bezier(.16,1,.3,1)}details[open] .ds-chev{transform:rotate(90deg)}.ds-step-detail{margin:6px 0 10px;padding:12px 14px;border-radius:12px;background:var(--surface-2,#f4f4f5);font-family:var(--font-mono,'Geist Mono Variable',ui-monospace,monospace);font-size:12px;line-height:18px}"
    },
