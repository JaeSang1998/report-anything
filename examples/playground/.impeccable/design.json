      "html": "<nav class=\"ds-sidebar\"><button class=\"ds-side-row\">New chat</button><h2 class=\"ds-side-label\">Today</h2><a class=\"ds-side-row ds-current\" href=\"#\">Revenue by region</a><a class=\"ds-side-row\" href=\"#\">Churn cohort review</a></nav>",
      "css": ".ds-sidebar{width:264px;padding:12px 8px;background:var(--surface-1,#fafafa);font-family:var(--font,'Geist Variable',system-ui,sans-serif);font-size:14px;color:var(--fg,#09090b)}.ds-side-label{margin:12px 0 0;padding:4px 10px;font-size:12px;font-weight:500;color:var(--fg-3,#71717a)}.ds-side-row{display:flex;align-items:center;width:100%;height:34px;padding:0 10px;border:none;border-radius:10px;background:none;color:inherit;font:inherit;text-decoration:none;cursor:pointer;box-sizing:border-box}.ds-side-row:hover,.ds-current{background:var(--surface-3,#e9e9ec)}.ds-side-row:focus-visible{outline:2px solid var(--accent,#2563eb);outline-offset:2px}"
